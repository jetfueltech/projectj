# Used by NextAuth (web sessions) and to sign mobile bearer JWTs.
# Generate one: openssl rand -base64 32
AUTH_SECRET=

# Vercel Postgres (or any Postgres URL with sslmode=require).
POSTGRES_URL=

# Vercel Blob — created automatically when you provision a Blob store on Vercel.
BLOB_READ_WRITE_TOKEN=

# Where the Python processing service is reachable from the web app.
PYTHON_SERVICE_URL=http://localhost:8000

# Shared secret authenticating the web <-> python internal callbacks.
# Must match `INTERNAL_SECRET` in python/.env.
INTERNAL_SECRET=
